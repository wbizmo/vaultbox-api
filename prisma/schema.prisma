generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum FileStatus {
  ACTIVE
  DELETED
}

enum UploadSessionStatus {
  UPLOADING
  COMPLETING
  COMPLETED
  ABORTED
  EXPIRED
}

model User {
  id                  String     @id @default(cuid())
  name                String
  email               String     @unique
  password            String
  role                UserRole   @default(USER)
  status              UserStatus @default(ACTIVE)
  planId              String?
  storageUsed         BigInt     @default(0)
  reservedUploadBytes BigInt     @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  plan           Plan?           @relation(fields: [planId], references: [id])
  files          File[]
  folders        Folder[]
  tokens         DownloadToken[]
  auditLogs      AuditLog[]
  uploadSessions UploadSession[]

  @@index([status, createdAt, id])
  @@index([createdAt, id])
  @@index([planId])
}

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  priceMonthly Int
  storageLimit BigInt
  createdAt    DateTime @default(now())

  users User[]
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  files File[]

  @@index([userId, createdAt, id])
}

model File {
  id           String     @id @default(cuid())
  originalName String
  storedName   String
  mimeType     String
  size         BigInt
  path         String
  checksum     String?
  status       FileStatus @default(ACTIVE)
  userId       String
  folderId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user   User            @relation(fields: [userId], references: [id])
  folder Folder?         @relation(fields: [folderId], references: [id])
  tokens DownloadToken[]

  @@index([userId, status, createdAt, id])
  @@index([userId, status, updatedAt, id])
  @@index([userId, status, size, id])
  @@index([userId, status, originalName, id])
  @@index([folderId])
}

model DownloadToken {
  id        String    @id @default(cuid())
  token     String    @unique
  fileId    String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  file File @relation(fields: [fileId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([fileId, expiresAt])
  @@index([expiresAt])
}

model UploadSession {
  id               String              @id @default(cuid())
  userId           String
  originalName     String
  mimeType         String
  expectedSize     BigInt
  expectedChecksum String?
  chunkSize        Int
  partCount        Int
  status           UploadSessionStatus @default(UPLOADING)
  expiresAt        DateTime
  fileId           String?             @unique
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user  User         @relation(fields: [userId], references: [id])
  parts UploadPart[]

  @@index([userId, status, expiresAt])
  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

model UploadPart {
  id         String   @id @default(cuid())
  sessionId  String
  partNumber Int
  offset     BigInt
  size       BigInt
  checksum   String
  storedName String
  createdAt  DateTime @default(now())

  session UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, partNumber])
  @@index([sessionId, offset])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  userId    String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt, id])
  @@index([action, createdAt, id])
  @@index([userId, createdAt, id])
}
