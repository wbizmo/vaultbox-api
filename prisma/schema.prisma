generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum FileStatus {
  ACTIVE
  DELETED
}

enum FileDeletionStatus {
  PENDING
  DONE
  DEAD
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
}

enum ReservationState {
  PENDING
  COMMITTED
  RELEASED
}

enum UploadSessionStatus {
  UPLOADING
  COMPLETING
  COMPLETED
  ABORTED
  EXPIRED
}

model User {
  id                  String     @id @default(cuid())
  name                String
  email               String     @unique
  password            String
  role                UserRole   @default(USER)
  status              UserStatus @default(ACTIVE)
  planId              String?
  storageUsed         BigInt     @default(0)
  reservedUploadBytes BigInt     @default(0)
  // Bumped by every suspend/reactivate/delete/role change. JWTs carry the value they were issued
  // under (claim "av"); a mismatch means the session was revoked. See docs/DEPLOYMENT.md.
  authVersion         Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  plan            Plan?               @relation(fields: [planId], references: [id])
  files           File[]
  folders         Folder[]
  tokens          DownloadToken[]
  auditLogs       AuditLog[]
  uploadSessions  UploadSession[]
  entitlements    PlanEntitlement[]
  reservations    UploadReservation[]
  idempotencyKeys IdempotencyKey[]

  @@index([status, createdAt, id])
  @@index([createdAt, id])
  @@index([planId])
}

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  priceMonthly Int
  storageLimit BigInt
  createdAt    DateTime @default(now())

  users        User[]
  entitlements PlanEntitlement[]
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  files File[]

  @@index([userId, createdAt, id])
}

model File {
  id           String     @id @default(cuid())
  originalName String
  storedName   String
  mimeType     String
  size         BigInt
  path         String
  checksum     String?
  status       FileStatus @default(ACTIVE)
  userId       String
  folderId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user   User            @relation(fields: [userId], references: [id])
  folder Folder?         @relation(fields: [folderId], references: [id])
  tokens DownloadToken[]

  @@index([userId, status, createdAt, id])
  @@index([userId, status, updatedAt, id])
  @@index([userId, status, size, id])
  @@index([userId, status, originalName, id])
  @@index([folderId])
}

model DownloadToken {
  id        String    @id @default(cuid())
  token     String    @unique
  fileId    String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  file File @relation(fields: [fileId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([fileId, expiresAt])
  @@index([expiresAt])
}

model UploadSession {
  id                   String              @id @default(cuid())
  userId               String
  originalName         String
  mimeType             String
  expectedSize         BigInt
  expectedChecksum     String?
  chunkSize            Int
  partCount            Int
  status               UploadSessionStatus @default(UPLOADING)
  expiresAt            DateTime
  fileId               String?             @unique
  completedAt          DateTime?
  // Completion lease / fencing: set when a completer claims the session, renewed by a
  // heartbeat while it assembles, and required by the final commit. See docs/UPLOADS.md.
  completionToken      String?
  completionLeaseUntil DateTime?
  completionGeneration Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user  User         @relation(fields: [userId], references: [id])
  parts UploadPart[]

  @@index([userId, status, expiresAt])
  @@index([status, expiresAt])
  @@index([status, completionLeaseUntil])
  @@index([userId, createdAt])
}

model UploadPart {
  id         String   @id @default(cuid())
  sessionId  String
  partNumber Int
  offset     BigInt
  size       BigInt
  checksum   String
  storedName String
  createdAt  DateTime @default(now())

  session UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, partNumber])
  @@index([sessionId, offset])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  userId    String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt, id])
  @@index([action, createdAt, id])
  @@index([userId, createdAt, id])
}

// Server-owned proof that a user may select a paid plan. Created and revoked
// only by authenticated, idempotent billing events (see BillingEvent).
model PlanEntitlement {
  id         String            @id @default(cuid())
  userId     String
  planId     String
  status     EntitlementStatus @default(ACTIVE)
  eventId    String            @unique
  validFrom  DateTime          @default(now())
  validUntil DateTime?
  revokedAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, planId, status])
}

// One row per processed provider event: the primary key makes webhook
// processing idempotent and replay-safe across instances.
model BillingEvent {
  id          String   @id
  type        String
  payloadHash String
  createdAt   DateTime @default(now())
}

// Durable owner of one one-shot upload's pending quota (x-upload-size path). Created in the same
// transaction as the quota increment; committed or released exactly once by compare-and-set;
// released by the sweeper when the lease lapses (crashed or stalled worker).
model UploadReservation {
  id         String           @id @default(cuid())
  userId     String
  bytes      BigInt
  state      ReservationState @default(PENDING)
  leaseUntil DateTime
  fileId     String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([state, leaseUntil])
  @@index([userId, state])
}

// Durable, actor-scoped idempotency for create operations. The claim and the business mutation commit
// in ONE transaction, so there is no visible "pending" state to expire or overwrite: a committed row
// means the operation happened and `response` is its result.
model IdempotencyKey {
  id          String   @id
  userId      String
  operation   String
  key         String
  fingerprint String
  status      Int?
  response    Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, key])
  @@index([expiresAt])
}

// Shared fixed-window counter used ONLY when Redis is unavailable, for abuse-sensitive routes
// (login, registration, download-token issuance): it keeps limits global across replicas.
// The key is a SHA-256 of namespace+identity, so no email or IP address is stored.
model RateLimitWindow {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

// Durable outbox for physical byte removal. One row per logically deleted file, inserted in the same
// statement that marks the File DELETED and refunds quota, so the two can never disagree. A worker
// claims rows under a lease (FOR UPDATE SKIP LOCKED), removes the bytes (a missing object counts as
// success), and retries with backoff until DONE or, after too many attempts, DEAD. Deliberately has no
// foreign keys: it is a self-contained job record that outlives the rows it was created from.
model FileDeletion {
  id            String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  fileId        String             @unique
  userId        String
  storedName    String
  size          BigInt
  status        FileDeletionStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  lockedUntil   DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  @@index([status, nextAttemptAt])
  @@index([userId])
}
