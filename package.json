{
  "name": "vaultbox-api",
  "version": "2.5.0",
  "description": "Secure cloud storage API with resumable chunked uploads, range downloads, atomic quota enforcement, Redis coordination, audit logs, and administrative controls.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "npm run deploy:generate && npm run typecheck && node scripts/verify-build.js",
    "lint": "eslint src scripts test prisma",
    "test": "node --test --test-concurrency=1",
    "benchmark": "node scripts/benchmark.js",
    "deploy:migrate": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "deploy:generate": "prisma generate",
    "benchmark:transfers": "node scripts/benchmark-transfers.js",
    "benchmark:queries": "node scripts/profile-postgres.js",
    "security:scan": "node scripts/security-static-check.js",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "keywords": [
    "cloud-storage",
    "file-storage",
    "fastify",
    "prisma",
    "postgresql",
    "redis",
    "jwt",
    "swagger",
    "api",
    "saas",
    "resumable-downloads",
    "resumable-uploads",
    "chunked-uploads",
    "http-range",
    "parallel-downloads"
  ],
  "author": "Williams Ashibuogwu",
  "license": "MIT",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@aws-sdk/lib-storage": "3.1165.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "prisma": "6.12.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
