{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "types/**/*.ts",
    "scripts/security-static-check.js",
    "scripts/verify-release-gate.js",
    "scripts/redact-test-artifacts.js",
    "scripts/verify-build.js"
  ]
}
